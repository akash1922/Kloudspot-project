# =============================================================================
# Kohort EMS - Environment Variables (.env)
# =============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to ".env" in either the root or "backend/" folder.
# 2. In your Supabase Dashboard: Click the "Connect" button at the top header -> select "Session pooler" (or Direct connection).
# 3. Replace the placeholder values below with your real Supabase credentials.
# Note: The ".env" file is ignored by Git to protect your production keys.
# =============================================================================

# PostgreSQL / Supabase Database URL (must include ?sslmode=require for Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Database Username (In Supabase, this is typically "postgres.[your-project-ref]" for pooler, or "postgres" for direct connection)
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF

# Database Password (The password you chose when creating your Supabase project)
SPRING_DATASOURCE_PASSWORD=YOUR_ACTUAL_SUPABASE_PASSWORD

# JWT Secret Key (Any random 32+ character string for signing session tokens)
JWT_SECRET=kohort_ems_super_secret_jwt_key_that_is_at_least_256_bits_long_2026

# Server Port
PORT=8080
